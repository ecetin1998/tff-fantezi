{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tff-fantezi",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat","global_fetch_strictly_public"],
  "assets": {"directory": ".open-next/assets","binding": "ASSETS"},
  "cache": {"enabled": true},
  "r2_buckets": [{"binding":"NEXT_INC_CACHE_R2_BUCKET","bucket_name":"tff-fantezi-isr-cache"}],
  "d1_databases": [{"binding":"NEXT_TAG_CACHE_D1","database_name":"tff-fantezi-next-tag-cache","database_id":"a3437c8c-d671-48c4-a431-c8a807b5dc35"}],
  "services": [{"binding":"WORKER_SELF_REFERENCE","service":"tff-fantezi"}],
  "durable_objects": {"bindings":[{"name":"NEXT_CACHE_DO_QUEUE","class_name":"DOQueueHandler"},{"name":"NEXT_TAG_CACHE_DO_SHARDED","class_name":"DOShardedTagCache"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["DOQueueHandler","DOShardedTagCache"]}],
  "images": {"binding": "IMAGES"},
  "observability": {"enabled": true},
  "routes": [
    {"pattern":"fanteziligrehberi.com","custom_domain":true},
    {"pattern":"www.fanteziligrehberi.com","custom_domain":true}
  ]
}
